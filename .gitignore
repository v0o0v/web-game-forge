# OMC 오케스트레이션 상태 (세션별, 커밋 제외)
.omc/

# OS
.DS_Store
Thumbs.db
desktop.ini

# 로그 / 임시
*.log
*.tmp
_t.json

# Node (향후 대비)
node_modules/

# WGF Studio export 스모크 테스트 산출물 (test-export.mjs 가 임시 생성·정리, KEEP=1 보존 시 격리)
games/_export-smoke/

# WGF Studio 브리지 결정형 스킬 트랙 임시 씬 직렬화 (skill_run_tool 가 현재 씬을 lint 실행용으로 씀)
games/_editor-samples/_wgf-tmp/

# sprite-picker 세션 산출물 (피커에 주입하는 후보 데이터 — 매 요청마다 새로 생성)
skills/wgf-sprite-picker/picker/data.js
# sprite-picker "선택 완료" 핸드오프 파일 (serve.mjs 가 사용자 선택을 여기에 저장)
.sprite-picker-selection.json
# sprite-picker 세션 후보 썸네일(애니 SVG 등 — 매 요청마다 생성)
skills/wgf-sprite-picker/picker/_session/

# sprite-picker 다운로드 큐 (런타임 상태 파일 — 커밋 불필요)
/.sprite-picker-downloads.json

# assets-library 팩 원본 (fetch-pack.mjs 가 받은 압축 해제 결과 — 분석에만 쓰고 커밋 안 함)
assets-library/*/raw/

# assets-library 분석 산출 바이너리 (analyze-pack.mjs 가 생성 — 재생성 가능하므로 커밋 안 함)
assets-library/*/*.png
assets-library/*/*.jpg
assets-library/*/*.jpeg
assets-library/*/*.gif
assets-library/*/*.thumb.png

# 단, 라이브러리 메타데이터는 커밋 유지 (재생성 기준점 + 편집기 변경사항 보존)
!assets-library/library.json
!assets-library/*/README.md
!assets-library/*/analysis.json
